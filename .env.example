# Supabase Configuration (Required for Auth)

# Get these from your Supabase project dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local development URL controls (optional)
# Keep auth redirect origin aligned with the URL you actually open in the browser.
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_AUTH_REDIRECT_ORIGIN=http://localhost:3000

# AI provider: gemini | qwen
AI_PROVIDER=gemini

# Gemini credentials
GEMINI_API_KEY=
# Gemini model versions (optional, overrides built-in defaults)
GEMINI_MODEL_FAST=gemini-3.0-flash
GEMINI_MODEL_PRO=gemini-3.1-pro
GEMINI_MODEL_IMAGE=imagen-4.0-generate-001

# Qwen credentials (used when AI_PROVIDER=qwen)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen model versions (optional, overrides built-in defaults)
QWEN_MODEL_FAST=qwen3.5-flash
QWEN_MODEL_PRO=qwen3.6-plus
QWEN_MODEL_IMAGE=qwen-image-2.0